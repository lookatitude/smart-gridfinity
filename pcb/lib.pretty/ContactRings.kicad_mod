(footprint "ContactRings"
	(version 20241229)
	(generator "script")
	(layer "B.Cu")
	(descr "Four concentric contact rings for a Gridfinity bin foot: ID centre, LED data, 5 V, ground")
	(attr smd exclude_from_bom)
	(pad "1" smd circle (at 0 0) (size 5.2 5.2) (layers "B.Cu" "B.Mask"))
	(pad "2" smd custom (at 5.4 0) (size 1.2 1.2) (layers "B.Cu" "B.Mask")
		(options (clearance outline) (anchor circle))
		(primitives (gr_circle (center -5.4 0) (end 0 0) (width 2.0) (fill no))))
	(pad "3" smd custom (at 9.2 0) (size 1.2 1.2) (layers "B.Cu" "B.Mask")
		(options (clearance outline) (anchor circle))
		(primitives (gr_circle (center -9.2 0) (end 0 0) (width 2.0) (fill no))))
	(pad "4" smd custom (at 12.9 0) (size 1.2 1.2) (layers "B.Cu" "B.Mask")
		(options (clearance outline) (anchor circle))
		(primitives (gr_circle (center -12.9 0) (end 0 0) (width 1.8) (fill no))))
)
