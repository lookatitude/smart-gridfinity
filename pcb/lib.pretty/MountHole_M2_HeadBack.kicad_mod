(footprint "MountHole_M2_HeadBack"
	(version 20241229)
	(generator "script")
	(layer "F.Cu")
	(descr "Plain 2.2 mm hole for an M2 screw, not plated. The 3.8 mm head sits on the back; keep back copper 0.3 mm clear of a 4.2 mm circle (drawn on B.Fab; the layout adds the keep-out area)")
	(attr exclude_from_pos_files exclude_from_bom)
	(fp_circle (center 0 0) (end 1.9 0) (stroke (width 0.1) (type solid)) (fill no) (layer "B.Fab"))
	(fp_circle (center 0 0) (end 2.1 0) (stroke (width 0.05) (type solid)) (fill no) (layer "B.Fab"))
	(pad "" np_thru_hole circle (at 0 0) (size 2.2 2.2) (drill 2.2) (layers "*.Cu" "*.Mask"))
)
